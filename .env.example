# CIT Campus Scheduling & Venue Management — Environment Variables
# Copy this file to .env and configure your keys.

# Port for FastAPI Backend (Default: 8000)
PORT=8000

# Google Gemini API Key for NLP request parsing & explainability
# Optional: if omitted, system falls back to offline deterministic rule parser.
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS (Default: * or http://localhost:3000)
FRONTEND_URL=http://localhost:3000

