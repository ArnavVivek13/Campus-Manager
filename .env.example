# CIT & IIT BBSR Campus Scheduling & Venue Management — Environment Variables
# Copy this file to .env and configure your keys.

# ===================================================================
# 1. CORE SERVER SETTINGS
# ===================================================================
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# ===================================================================
# 2. DATABASE (DBMS)
# ===================================================================
# SQLite (zero-config, local dev):
DATABASE_URL=sqlite:///./campus.db
# PostgreSQL (production / multi-server):
# DATABASE_URL=postgresql://user:password@localhost:5432/campus_scheduler

# ===================================================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ===================================================================
# Generate a random 32+ character string in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=campus-scheduler-secret-key-2027-cit-iitbbsr-dev
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===================================================================
# 4. AI & NLP (Google Gemini)
# ===================================================================
# Get your free key at: https://aistudio.google.com/app/apikey
# OPTIONAL: If left blank or not set, the backend automatically uses
# the offline regex & rule-based parser with 0 external network calls.
GEMINI_API_KEY=

# ===================================================================
# 5. OAUTH 2.0 / GOOGLE SINGLE SIGN-ON (SSO)
# ===================================================================
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# OPTIONAL: If omitted, the built-in Demo SSO (/api/auth/oauth/demo-login)
# is used for 1-click test logins as Admin, Faculty, Club Lead, or Student.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/oauth/google/callback
